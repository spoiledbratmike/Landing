# Copy this file to .env and fill in your values.
# For Netlify, set these in Site settings → Environment variables instead.

# SMTP (SiteGround or your email provider)
SMTP_HOST=your-smtp-host.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-smtp-user@domain.com
SMTP_FROM_NAME=Your Name

# Where Peter receives call-request notifications
NOTIFY_TO=your-notify@domain.com

# Neon PostgreSQL (stores form submissions)
DATABASE_URL=your-database-connection-string

# Site URL (for self-check download link in emails)
SITE_URL=https://your-site.netlify.app
