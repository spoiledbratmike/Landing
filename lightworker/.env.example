# Neon Database (Postgres)
# Get your connection string from https://console.neon.tech/
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# Maildog.io SMTP Credentials
# Get from your Maildog.io dashboard
MAILDOG_SMTP_HOST=smtp.maildog.io
MAILDOG_SMTP_PORT=587
MAILDOG_SMTP_SECURE=false
MAILDOG_SMTP_USER=your_maildog_username
MAILDOG_SMTP_PASS=your_maildog_password
MAILDOG_FROM_EMAIL=hello@lightworkercoach.co.uk
MAILDOG_FROM_NAME=The Lightworker Coach

# API endpoint for form submissions (if using serverless functions)
# For Netlify: /.netlify/functions/submit
# For Vercel: /api/submit
# For custom backend: https://your-api.com/submit
VITE_FORM_ENDPOINT=
